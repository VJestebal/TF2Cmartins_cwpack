"VertexLitGeneric"
{
	"$basetexture" "models\workshop\weapons\c_models\c_handcannon\c_handcannon.vtf"
	// $bumpmap is a shared 16x16 flat normal map, and is needed or lightwarp won't shade correctly.
	"$bumpmap"     "models/player/shared/shared_normal"

	"$basemapalphaphongmask" "1"

	"$yellow" "0"
	"$one" "1"

	"$phong" "1"
	"$phongexponent" "20"
	"$phongboost" "2"	
	"$phongfresnelranges"	"[.3 1 8]"
	"$halflambert" "0"

	"$lightwarptexture" "models/lightwarps/softened_weapon_lightwarp"		
//	"$lightwarptexture" "models\weapons\c_items/c_ambassador_lightwarp"

	// Rim lighting parameters
//	"$rimlight" "1"												// To enable rim lighting (requires phong)
//	"$rimlightexponent" "4"										// Exponent for phong component of rim lighting	
//	"$rimlightboost" "2"	

//	"$envmap" "env_cubemap"
//	"$envmaptint" "[.08 .06 .09]"
//	"$basealphaenvmapmask"		"1"									// Boost for ambient cube component of rim lighting

	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps/cubemap_sheen001"
	"$sheenmapmask" 		"Effects/AnimatedSheen/animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}